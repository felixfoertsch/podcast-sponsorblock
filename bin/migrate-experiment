#!/usr/bin/env bash
set -euo pipefail
usage() { printf 'Usage: %s --input BACKUP-TAR --stable-catalog JSON --database SQLITE [--apply] [--debug-database SQLITE]\n' "$0" >&2; exit 2; }
main() {
 local input= catalog= database= apply=0 debug_db=
 while (($#)); do case "$1" in
  --input) input=${2:?}; shift 2;; --stable-catalog) catalog=${2:?}; shift 2;; --database) database=${2:?}; shift 2;;
  --debug-database) debug_db=${2:?}; shift 2;; --apply) apply=1; shift;; --dry-run) apply=0; shift;; *) usage;; esac; done
 [[ -f $input && -f $catalog && -n $database ]] || usage
 tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  umask 077
 # Python tarfile validates every member before writing; only regular approved files/directories pass.
 python3 - "$input" "$tmp" <<'PY'
import os, pathlib, sys, tarfile
archive, root = sys.argv[1:]
allowed = ('config/absdatabase.sqlite', 'config/debug-overlay.sqlite', 'metadata/ad-analysis-corpus/')
limit = 10 * 1024**3 + 512 * 1024**2
with tarfile.open(archive, 'r:*') as tar:
    members = []
    total = 0
    seen = set()
    for m in tar:
        members.append(m)
        if len(members) > 100000: raise SystemExit('archive_member_count')
        name = m.name
        if name in seen: raise SystemExit('duplicate_archive_path')
        seen.add(name)
        if name.startswith('/') or any(x in ('..', '') for x in pathlib.PurePosixPath(name).parts): raise SystemExit('unsafe_archive_path')
        if not (m.isdir() or m.isfile()) or m.issym() or m.islnk() or m.isdev() or m.size < 0: raise SystemExit('unsafe_archive_member')
        if m.size > 256 * 1024**2: raise SystemExit('archive_member_limit')
        total += m.size
        if total > limit: raise SystemExit('archive_size_limit')
    for m in members:
        if not any(m.name == x.rstrip('/') or (x.endswith('/') and m.name.startswith(x)) for x in allowed): continue
        dest = pathlib.Path(root, m.name)
        if m.isdir(): dest.mkdir(parents=True, exist_ok=True); continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        src = tar.extractfile(m)
        if src is None: raise SystemExit('archive_read_failed')
        with open(dest, 'xb') as out:
            remaining = m.size
            while remaining:
                chunk = src.read(min(1024*1024, remaining))
                if not chunk: raise SystemExit('archive_truncated')
                out.write(chunk); remaining -= len(chunk)
PY
 MIGRATION_INPUT="$input" MIGRATION_COPY="$tmp" MIGRATION_CATALOG="$catalog" MIGRATION_DB="$database" MIGRATION_DEBUG_DB="$debug_db" MIGRATION_APPLY="$apply" node --input-type=module --import tsx <<'JS'
const fs=await import('node:fs'), path=await import('node:path'), Database=(await import('better-sqlite3')).default;
const m=await import('./src/migration.ts'), root=process.env.MIGRATION_COPY, source=path.join(root,'config/absdatabase.sqlite');
const old=new Database(source,{readonly:true,fileMustExist:true});
const shows=old.prepare("SELECT p.id,p.feedURL,l.id AS libraryItemId,l.extraData FROM podcasts p JOIN libraryItems l ON l.mediaId=p.id AND l.mediaType='podcast'").all().map(r=>({id:r.id,libraryItemId:r.libraryItemId,feedUrl:r.feedURL,consent:Boolean(JSON.parse(r.extraData||'{}').adAnalysisEnabled)}));
const episodes=old.prepare("SELECT e.id,e.podcastId AS showId,e.extraData,e.enclosureURL FROM podcastEpisodes e").all().map(r=>{let d={};try{d=JSON.parse(r.extraData||'{}')}catch{};return{id:r.id,showId:r.showId,guid:d.guid??null,enclosureUrl:r.enclosureURL??null,sourceSha256:d.adAnalysis?.sourceSha256??null,analysis:d.adAnalysis??null}});
const catalog=JSON.parse(fs.readFileSync(process.env.MIGRATION_CATALOG));
const input={shows,episodes,corpusDir:path.join(root,'metadata/ad-analysis-corpus')};
if(fs.existsSync(path.join(root,'config/debug-overlay.sqlite'))){const debug=new Database(path.join(root,'config/debug-overlay.sqlite'),{readonly:true});
 const notes=debug.prepare('SELECT route_path AS routePath,note,waiting_on AS waitingOn,updated_at AS updatedAt FROM notes').all();
 const subItems=debug.prepare('SELECT id,name,scope_pattern AS scopePattern,created_at AS createdAt FROM sub_items').all();
 const statuses=debug.prepare('SELECT sub_item_id AS subItemId,route_path AS routePath,status,note,updated_at AS updatedAt FROM sub_item_status').all(); input.debugImport={notes,subItems,statuses};debug.close();}
const {createHash}=await import('node:crypto'); const hash=createHash('sha256'); for await(const chunk of fs.createReadStream(process.env.MIGRATION_INPUT))hash.update(chunk); const archiveSha256=hash.digest('hex'); const bytes=Buffer.from(JSON.stringify({archiveSha256,catalogSha256:m.sha256(fs.readFileSync(process.env.MIGRATION_CATALOG)),serverId:process.env.PSB_STABLE_URL||'https://audiobookshelf.felixfoertsch.de'}));
const db=m.openMigrationDatabase(process.env.MIGRATION_APPLY==='1'?process.env.MIGRATION_DB:':memory:');
try {const result=m.migrateCopy(input,catalog.shows,catalog.episodes,db,bytes,{apply:process.env.MIGRATION_APPLY==='1',debugDbPath:process.env.MIGRATION_DEBUG_DB||undefined,serverId:process.env.PSB_STABLE_URL||'https://audiobookshelf.felixfoertsch.de'});
 console.log(JSON.stringify({dryRun:process.env.MIGRATION_APPLY!=='1',digest:result.digest,archiveSha256,shows:shows.length,episodes:episodes.length,matches:result.matches.filter(x=>x.stableEpisodeId).length,conflicts:result.matches.filter(x=>x.reason==='conflict').length,unmatched:result.matches.filter(x=>x.reason==='unmatched').length,corpus:fs.readdirSync(input.corpusDir).length,debugImported:result.debugImported,debugArchived:result.debugArchived,resultsImported:result.resultsImported,corpusImported:result.corpusImported,repeated:result.repeated,integrity:db.pragma('integrity_check')[0].integrity_check,foreignKeyViolations:db.pragma('foreign_key_check').length}));
} finally {db.close();old.close();}
JS
}
main "$@"
